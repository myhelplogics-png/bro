# Bropatch Environment Configuration
# Copy this file to .env and update with your actual values

# =====================================================
# DATABASE CONFIGURATION
# =====================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bropatch_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# =====================================================
# APPLICATION SETTINGS
# =====================================================
APP_NAME=Bropatch
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost

# =====================================================
# ADMIN SETTINGS
# =====================================================
ADMIN_SESSION_TIMEOUT=3600
ADMIN_SESSION_NAME=bropatch_admin_session
ADMIN_COOKIE_SECURE=false
ADMIN_COOKIE_HTTPONLY=true
ADMIN_COOKIE_SAMESITE=Lax

# =====================================================
# PAYMENT GATEWAY (Razorpay/Stripe)
# =====================================================
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# =====================================================
# EMAIL CONFIGURATION
# =====================================================
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=465
MAIL_USERNAME=your_email
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=noreply@bropatch.com
MAIL_FROM_NAME=Bropatch

# =====================================================
# AWS S3 CONFIGURATION (File Storage)
# =====================================================
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=bropatch-uploads

# =====================================================
# JWT CONFIGURATION (For Mobile/API Authentication)
# =====================================================
JWT_SECRET=your_very_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY=86400

# =====================================================
# TWILIO CONFIGURATION (SMS/WhatsApp)
# =====================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =====================================================
# GOOGLE MAPS API
# =====================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =====================================================
# LOGGING
# =====================================================
LOG_CHANNEL=stack
LOG_LEVEL=debug

# =====================================================
# CACHE
# =====================================================
CACHE_DRIVER=file
CACHE_TTL=3600

# =====================================================
# ADMIN USERS (For Initial Setup)
# =====================================================
ADMIN_DEFAULT_EMAIL=admin@bropatch.com
ADMIN_DEFAULT_PASSWORD=Admin@Bropatch2026!

# =====================================================
# FEATURE FLAGS
# =====================================================
FEATURE_PROVIDER_VERIFICATION=true
FEATURE_PAYMENT_GATEWAY=true
FEATURE_NOTIFICATIONS=true
FEATURE_ANALYTICS=true
FEATURE_DISPUTE_RESOLUTION=true
